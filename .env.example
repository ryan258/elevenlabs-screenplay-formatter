# ElevenLabs API key surfaced to the React app via vite.config.ts
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Python backend: do not hardcode endpoints in code; configure explicitly.
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_TIMEOUT_S=30

# Local ffmpeg binary name/path (used by Python concat/mixing)
FFMPEG_BIN=ffmpeg

# Flask session signing key (required for non-dev use)
FLASK_SECRET_KEY=dev

# Upload/temp working directory for server-side concat/mixing
UPLOAD_DIR=uploads

# Optional: override the concatenation server endpoint used for merging audio
# VITE_CONCAT_SERVER_URL=http://localhost:3001/concatenate
